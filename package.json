{
  "name": "dancemania-redesign-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test:routes": "PLAYWRIGHT_BROWSERS_PATH=./.browsers node scripts/routes.mjs",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=./.browsers playwright test tests/journeys.spec.ts",
    "test:motion": "PLAYWRIGHT_BROWSERS_PATH=./.browsers playwright test tests/motion.spec.ts",
    "capture": "PLAYWRIGHT_BROWSERS_PATH=./.browsers node scripts/routes.mjs --capture"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-slot": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "latest",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
